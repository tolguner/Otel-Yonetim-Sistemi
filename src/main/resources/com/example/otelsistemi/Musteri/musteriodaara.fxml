<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.Controllers.Musteri.MusteriOdaAraController">
    <BorderPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" 
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <top>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="90.0" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #2c3e50;" 
                   text="ODA ARAMA" />
        </top>
        
        <left>
            <VBox alignment="TOP_CENTER" spacing="15" style="-fx-background-color: #ecf0f1; -fx-padding: 20;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Arama Kriterleri"/>
                
                <!-- Tarih Seçimi -->
                <VBox spacing="5">
                    <Label text="Giriş Tarihi"/>
                    <DatePicker fx:id="dpGirisTarihi" prefWidth="200"/>
                    
                    <Label text="Çıkış Tarihi"/>
                    <DatePicker fx:id="dpCikisTarihi" prefWidth="200"/>
                </VBox>
                
                <!-- Oda Tipi -->
                <VBox spacing="5">
                    <Label text="Oda Tipi"/>
                    <ComboBox fx:id="cmbOdaTipi" prefWidth="200">
                        <items>
                            <!-- Oda tipleri veritabanından çekilecek -->
                        </items>
                    </ComboBox>
                </VBox>
                
                <!-- Kişi sayısı seçimi -->
                <VBox spacing="5">
                    <Label text="Kişi Sayısı"/>
                    <ComboBox fx:id="cmbKisiSayisi" prefWidth="200"/>
                    <Label text="(1-5 kişi arası seçilebilir)" 
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
                
                <Button fx:id="btnAra" onAction="#odalariAra" text="Ara"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                        prefWidth="150"/>
                
                <Button fx:id="btnGeriDon" onAction="#geriDon" text="Geri Dön"
                        style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                
                <Label fx:id="lblMesaj" wrapText="true" textAlignment="CENTER"/>
                
                <VBox spacing="10">
                    <Label fx:id="lblBakiye" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="lblToplamTutar" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                </VBox>
            </VBox>
        </left>
        
        <center>
            <VBox style="-fx-background-color: white; -fx-padding: 20;">
                <TableView fx:id="tblOdalar" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOdaNo" text="Oda No" prefWidth="80"/>
                        <TableColumn fx:id="colOdaTipi" text="Oda Tipi" prefWidth="100"/>
                        <TableColumn fx:id="colKapasite" text="Kapasite" prefWidth="80"/>
                        <TableColumn fx:id="colFiyat" text="Fiyat" prefWidth="100"/>
                        <TableColumn fx:id="colOzellikler" text="Özellikler" prefWidth="200"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
                    <Button fx:id="btnRezervasyonYap" onAction="#rezervasyonYap" text="Rezervasyon Yap"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
                </HBox>
            </VBox>
        </center>
        
    </BorderPane>
</AnchorPane>
