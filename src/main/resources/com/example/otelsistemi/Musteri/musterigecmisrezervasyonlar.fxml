<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.Controllers.Musteri.MusteriGecmisRezervasyonlarController">
    <BorderPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" 
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <!-- Sol Panel -->
        <left>
            <VBox alignment="TOP_CENTER" prefWidth="200.0" spacing="10" 
                  style="-fx-background-color: #2c3e50; -fx-padding: 10;">
                
                <Label text="DEĞERLENDİRME" 
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <VBox.margin>
                        <Insets bottom="20"/>
                    </VBox.margin>
                </Label>
                
                <Label text="Puan" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <ComboBox fx:id="cmbPuan" prefWidth="180"/>
                
                <Label text="Yorum" 
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <TextArea fx:id="txtDegerlendirme" prefHeight="100" 
                         promptText="Değerlendirmenizi yazın..."
                         wrapText="true"/>
                
                <Button fx:id="btnDegerlendir" text="Değerlendirme Ekle" 
                        prefWidth="180"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" 
                        onAction="#degerlendirmeEkle"/>
                
                <Button fx:id="btnGuncelle" text="Değerlendirme Güncelle" 
                        prefWidth="180"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" 
                        onAction="#degerlendirmeGuncelle"/>
                
                <Button fx:id="btnSil" text="Değerlendirme Sil" 
                        prefWidth="180"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" 
                        onAction="#degerlendirmeSil"/>
                
                <Region VBox.vgrow="ALWAYS"/> <!-- Boşluk -->
                
                <Button fx:id="btnGeriDon" text="Geri Dön" 
                        prefWidth="180"
                        style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" 
                        onAction="#geriDon"/>
            </VBox>
        </left>
        
        <!-- Ana İçerik -->
        <center>
            <VBox alignment="TOP_CENTER" style="-fx-background-color: #ecf0f1;">
                <Label alignment="CENTER" prefHeight="90.0" prefWidth="800.0" 
                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #2c3e50; -fx-background-radius: 0 0 20 20;" 
                       text="GEÇMİŞ REZERVASYONLAR" textAlignment="CENTER"/>
                
                <TableView fx:id="tblRezervasyonlar" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOdaNo" text="Oda No" prefWidth="80"/>
                        <TableColumn fx:id="colOdaAdi" text="Oda Adı" prefWidth="120"/>
                        <TableColumn fx:id="colOdaTipi" text="Oda Tipi" prefWidth="120"/>
                        <TableColumn fx:id="colBaslangicTarihi" text="Giriş Tarihi" prefWidth="120"/>
                        <TableColumn fx:id="colBitisTarihi" text="Çıkış Tarihi" prefWidth="120"/>
                        <TableColumn fx:id="colDegerlendirme" text="Değerlendirme" prefWidth="120"/>
                    </columns>
                    <VBox.margin>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </VBox.margin>
                </TableView>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane> 