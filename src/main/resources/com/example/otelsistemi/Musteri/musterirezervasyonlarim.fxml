<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.Controllers.Musteri.MusteriRezervasyonlarimController">
    <BorderPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" 
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <center>
            <VBox alignment="TOP_CENTER" style="-fx-background-color: #ecf0f1;">
                <Label alignment="CENTER" prefHeight="90.0" prefWidth="800.0" 
                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #2c3e50; -fx-background-radius: 0 0 20 20;" 
                       text="REZERVASYONLARIM" textAlignment="CENTER"/>
                
                <VBox alignment="TOP_CENTER" prefHeight="411.0" prefWidth="800.0" spacing="20.0">
                    <padding>
                        <Insets top="50.0"/>
                    </padding>

                    <Button fx:id="btnMevcutRezervasyonlar" text="Mevcut Rezervasyonlarım" 
                            prefWidth="200"
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" 
                            onAction="#mevcutRezervasyonlaraGit"/>
                    
                    <Button fx:id="btnGelecekRezervasyonlar" text="Gelecek Rezervasyonlar"
                            prefWidth="200"
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" 
                            onAction="#gelecekRezervasyonlaraGit"/>
                    
                    <Button fx:id="btnGecmisRezervasyonlar" text="Geçmiş Rezervasyonlarım" 
                            prefWidth="200"
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" 
                            onAction="#gecmisRezervasyonlaraGit"/>
                    
                    <Button fx:id="btnGeriDon" text="Geri Dön" 
                            prefWidth="150.0"
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" 
                            onAction="#geriDon">
                        <VBox.margin>
                            <Insets top="40.0"/>
                        </VBox.margin>
                    </Button>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane> 