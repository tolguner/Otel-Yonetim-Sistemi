<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.Controllers.Musteri.MusteriBakiyeController">
    <BorderPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" 
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <top>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="90.0" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #2c3e50;" 
                   text="BAKİYE İŞLEMLERİ" />
        </top>
        
        <center>
            <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 20;">
                
                <!-- Mevcut Bakiye -->
                <HBox alignment="CENTER" spacing="10">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Mevcut Bakiye: "/>
                    <Label fx:id="lblMevcutBakiye" style="-fx-font-size: 18px; -fx-text-fill: #27ae60;"/>
                </HBox>
                
                <!-- Bakiye Yükleme Alanı -->
                <VBox alignment="CENTER" spacing="15" style="-fx-padding: 20;">
                    <Label style="-fx-font-size: 16px;" text="Bakiye Yükleme"/>
                    <HBox alignment="CENTER" spacing="10">
                        <TextField fx:id="txtYuklenecekTutar" prefWidth="200" promptText="Yüklenecek Tutar"
                                 style="-fx-background-radius: 5;"/>
                        <Button fx:id="btnBakiyeYukle" onAction="#bakiyeYukle" text="Bakiye Yükle"
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;
                                       -fx-background-radius: 5;"/>
                    </HBox>
                </VBox>
                
                <!-- İşlem Geçmişi Tablosu -->
                <Label style="-fx-font-size: 16px;" text="İşlem Geçmişi"/>
                <TableView fx:id="tblIslemGecmisi" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTarih" text="Tarih" prefWidth="100"/>
                        <TableColumn fx:id="colIslemTipi" text="İşlem Tipi" prefWidth="100"/>
                        <TableColumn fx:id="colTutar" text="Tutar" prefWidth="100"/>
                        <TableColumn fx:id="colBakiye" text="Bakiye" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <!-- Alt Butonlar -->
                <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
                    <Button fx:id="btnGeriDon" onAction="#geriDon" text="Geri Dön"
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 5;"/>
                </HBox>
                
                <!-- Mesaj Label -->
                <Label fx:id="lblMesaj" alignment="CENTER" maxWidth="Infinity" 
                       style="-fx-font-size: 14px;"/>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane> 