<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.Controllers.Musteri.MusteriDegerlendirmeEkleController">
    <BorderPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" 
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        
        <top>
            <Label alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="90.0" 
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #2c3e50;" 
                   text="DEĞERLENDİRME EKLE" />
        </top>
        
        <center>
            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
                <Label text="Puanınız (1-5)" style="-fx-font-size: 16px;"/>
                <ComboBox fx:id="cmbPuan" prefWidth="200">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <Integer fx:value="1"/>
                            <Integer fx:value="2"/>
                            <Integer fx:value="3"/>
                            <Integer fx:value="4"/>
                            <Integer fx:value="5"/>
                        </FXCollections>
                    </items>
                </ComboBox>
                
                <Label text="Yorumunuz" style="-fx-font-size: 16px;"/>
                <TextArea fx:id="txtYorum" prefWidth="400" prefHeight="150" wrapText="true"/>
                
                <HBox alignment="CENTER" spacing="10">
                    <Button fx:id="btnKaydet" onAction="#degerlendirmeKaydet" text="Kaydet"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;"/>
                            
                    <Button fx:id="btnGeriDon" onAction="#geriDon" text="Geri Dön"
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                
                <Label fx:id="lblMesaj" style="-fx-font-size: 14px;"/>
            </VBox>
        </center>
        
    </BorderPane>
</AnchorPane> 