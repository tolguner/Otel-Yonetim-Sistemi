<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.Controllers.Yonetici.yoneticiMusteriIslemleriController">
    <BorderPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" 
                AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <center>
            <VBox alignment="TOP_CENTER" style="-fx-background-color: #ecf0f1;">
                <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" 
                       prefHeight="90.0" prefWidth="800.0" 
                       style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #2c3e50; -fx-background-radius: 0 0 20 0;" 
                       text="MÜŞTERİ İŞLEMLERİ" textAlignment="CENTER" />

                <HBox alignment="CENTER" spacing="20.0">
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>

                    <!-- Sol Panel - Form -->
                    <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="300.0" spacing="10.0" 
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 0);">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>

                        <Label text="MÜŞTERİ BİLGİLERİ" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                        <TextField fx:id="txtTcKimlikNo" promptText="TC Kimlik No" style="-fx-pref-height: 35; -fx-background-radius: 7;" />
                        <TextField fx:id="txtAd" promptText="Ad" style="-fx-pref-height: 35; -fx-background-radius: 7;" />
                        <TextField fx:id="txtSoyad" promptText="Soyad" style="-fx-pref-height: 35; -fx-background-radius: 7;" />
                        <TextField fx:id="txtEmail" promptText="Email" style="-fx-pref-height: 35; -fx-background-radius: 7;" />
                        <TextField fx:id="txtTelefon" promptText="Telefon" style="-fx-pref-height: 35; -fx-background-radius: 7;" />
                        <PasswordField fx:id="txtSifre" promptText="Şifre" style="-fx-pref-height: 35; -fx-background-radius: 7;" />

                        <Label fx:id="lblMesaj" alignment="CENTER" prefHeight="20.0" prefWidth="280.0" />

                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="btnEkle" text="Ekle" onAction="#musteriEkle" 
                                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 90; -fx-pref-height: 35; -fx-background-radius: 7;" />
                            <Button fx:id="btnGuncelle" text="Güncelle" onAction="#musteriGuncelle" 
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 90; -fx-pref-height: 35; -fx-background-radius: 7;" />
                            <Button fx:id="btnSil" text="Sil" onAction="#musteriSil" 
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 90; -fx-pref-height: 35; -fx-background-radius: 7;" />
                        </HBox>

                        <Button fx:id="btnTemizle" text="Temizle" onAction="#formuTemizle" 
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 280; -fx-pref-height: 35; -fx-background-radius: 7;" />
                        <Button fx:id="btnGeriDon" text="Geri Dön" onAction="#geriDon" 
                                style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 280; -fx-pref-height: 35; -fx-background-radius: 7;" />
                    </VBox>

                    <!-- Sağ Panel - Tablo -->
                    <VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="450.0" 
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 0);">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>

                        <Label text="MÜŞTERİ LİSTESİ" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

                        <TableView fx:id="tableMusteriler" VBox.vgrow="ALWAYS" style="-fx-background-radius: 7;">
                            <columns>
                                <TableColumn fx:id="colTcKimlikNo" text="TC Kimlik No" prefWidth="100" />
                                <TableColumn fx:id="colAd" text="Ad" prefWidth="70" />
                                <TableColumn fx:id="colSoyad" text="Soyad" prefWidth="70" />
                                <TableColumn fx:id="colEmail" text="Email" prefWidth="100" />
                                <TableColumn fx:id="colTelefon" text="Telefon" prefWidth="90" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane> 