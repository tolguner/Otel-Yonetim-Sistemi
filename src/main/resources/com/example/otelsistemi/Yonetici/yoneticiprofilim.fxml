                    <TextField fx:id="txtTelefon" maxWidth="200.0" prefHeight="25.0" prefWidth="200.0" promptText="Telefon" />
                    <PasswordField fx:id="txtSifre" maxWidth="200.0" prefHeight="25.0" prefWidth="200.0" promptText="Yeni Şifre" />
                    
                    <Label fx:id="lblMesaj" alignment="CENTER" prefHeight="17.0" prefWidth="239.0" textAlignment="CENTER" />
                    
