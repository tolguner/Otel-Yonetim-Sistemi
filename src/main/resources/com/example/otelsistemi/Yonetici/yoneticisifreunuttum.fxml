<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <BorderPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <center>
            <VBox alignment="TOP_CENTER" style="-fx-background-color: #ecf0f1;">
                <Label alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="90.0" prefWidth="800.0" style="-fx-font-size: 32px;                            -fx-font-weight: bold;                            -fx-text-fill: white;                            -fx-background-color: #2c3e50;                            -fx-background-radius: 0 0 20 20;" text="bOOking+" textAlignment="CENTER">
                </Label>

                <VBox alignment="CENTER" prefHeight="421.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #ecf0f1;                            -fx-padding: 40px;">
                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;" text="ŞİFRE YENİLEME" textFill="white">
                        <VBox.margin>
                            <Insets bottom="10.0" />
                        </VBox.margin>
                    </Label>

                    <HBox alignment="CENTER" spacing="10.0">
                        <Label prefWidth="150" style="-fx-text-fill: #34495e;" text="T.C. Kimlik Numarası" />
                        <TextField prefWidth="250" style="-fx-background-radius: 10;" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="10.0">
                        <Label prefWidth="150" style="-fx-text-fill: #34495e;" text="Telefon Numarası" />
                        <TextField prefWidth="250" style="-fx-background-radius: 10;" />
                    </HBox>

                    <HBox alignment="CENTER" spacing="10.0">
                        <Label prefWidth="150" style="-fx-text-fill: #34495e;" text="Mail" />
                        <TextField prefWidth="250" style="-fx-background-radius: 10;" />
                    </HBox>

                    <!-- Yeni Şifre -->
                    <HBox alignment="CENTER" spacing="10.0">
                        <Label prefWidth="150" style="-fx-text-fill: #34495e;" text="Yeni Şifre" />
                        <PasswordField prefWidth="250" style="-fx-background-radius: 10;" />
                    </HBox>

                    <!-- Hata Mesajı -->
                    <Label prefHeight="18.0" prefWidth="362.0" textAlignment="CENTER" textFill="RED" />
                    <HBox alignment="CENTER" prefHeight="25.0" prefWidth="720.0" spacing="10.0">
                        <HBox alignment="CENTER_LEFT" prefHeight="25.0" prefWidth="30.0">
                            <Button fx:id="btngeridon" alignment="CENTER" prefHeight="25.0" prefWidth="35.0"
                                    style="-fx-background-color: #34495e;                                    -fx-text-fill: white;                                    -fx-background-radius: 20;"
                                    text="&lt;"/>
                        </HBox>
                        <HBox prefHeight="25.0" prefWidth="260.0"/>

                        <Button fx:id="btnsifreyenile" prefWidth="135.0"
                                style="-fx-background-color: #34495e;                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 20;"
                                text="Şifre Yenile"/>
                        <HBox prefHeight="25.0" prefWidth="260.0"/>
                    </HBox>
                </VBox>
            </VBox>
        </center>
    </BorderPane>
</AnchorPane>
